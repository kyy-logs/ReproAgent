<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'sha256-<!--TRACE-HASH-->'; style-src 'unsafe-inline'; connect-src 'none'; img-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ReproAgent activity trace</title>
<style>
  :root {
    color-scheme: light dark;
    --ink: #1b1f24; --muted: #6b7280; --line: #d8dde3; --bg: #ffffff; --panel: #f7f8fa;
    --ok: #1a7f4b; --warn: #9a6700; --bad: #b42318; --accent: #24487a;
  }
  @media (prefers-color-scheme: dark) {
    :root { --ink: #e6e9ee; --muted: #9aa4b2; --line: #333a44; --bg: #14181d; --panel: #1b2027;
            --ok: #57c68a; --warn: #d5a021; --bad: #f0736a; --accent: #8ab4f8; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 1rem 1.25rem 3rem; background: var(--bg); color: var(--ink);
         font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
  main { max-width: 1800px; margin: 0 auto; }
  h1 { font-size: 1.35rem; margin: 0 0 .35rem; letter-spacing: -.01em; }
  h2 { font-size: .8rem; margin: 2.25rem 0 .75rem; text-transform: uppercase;
       letter-spacing: .08em; color: var(--muted); font-weight: 600; }
  h4 { font-size: .78rem; margin: 1rem 0 .35rem; color: var(--muted); font-weight: 600;
       text-transform: uppercase; letter-spacing: .05em; }
  a { color: var(--accent); }
  .meta { color: var(--muted); margin: 0 0 .25rem; font-size: .88rem; }
  .warnbox { border-left: 3px solid var(--warn); background: color-mix(in srgb, var(--warn) 10%, transparent);
             padding: .55rem .8rem; border-radius: 0 6px 6px 0; margin: .5rem 0; font-size: .88rem; }
  .stats { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem 0 0; padding: 0; list-style: none; }
  .stats li { background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
              padding: .5rem .8rem; min-width: 7.5rem; }
  .stats .k { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .stats .v { display: block; font-size: 1.1rem; font-variant-numeric: tabular-nums; }
  .unknown { color: var(--muted); font-style: italic; }
  .pill { display: inline-block; border-radius: 999px; padding: .05rem .5rem; font-size: .74rem;
          border: 1px solid currentColor; }
  .status-ok, .status-passed, .status-success { color: var(--ok); }
  .status-error, .status-failed, .status-fail { color: var(--bad); }
  .status-cancelled, .status-blocked, .status-degraded { color: var(--warn); }
  .status-incomplete, .status-unknown { color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: .86rem; }
  th { text-align: left; font-weight: 600; color: var(--muted); font-size: .72rem;
       text-transform: uppercase; letter-spacing: .05em; padding: .35rem .5rem;
       border-bottom: 1px solid var(--line); }
  td { padding: .3rem .5rem; border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
       vertical-align: top; }
  td.num { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--muted); }
  .span-name { font-weight: 500; }
  .attrs { color: var(--muted); font-size: .78rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .depth-1 { padding-left: 1.25rem; } .depth-2 { padding-left: 2.5rem; } .depth-3 { padding-left: 3.75rem; }
  .depth-4 { padding-left: 5rem; } .depth-5 { padding-left: 6.25rem; } .depth-6 { padding-left: 7.5rem; }
  details { border: 1px solid var(--line); border-radius: 8px; margin: .5rem 0; background: var(--panel); }
  details[open] { padding-bottom: .5rem; }
  summary { cursor: pointer; padding: .55rem .8rem; font-size: .88rem; display: flex;
            flex-wrap: wrap; gap: .5rem; align-items: baseline; }
  summary::marker { color: var(--muted); }
  summary .label { font-weight: 600; }
  summary .bytes { margin-left: auto; color: var(--muted); font-size: .78rem;
                   font-variant-numeric: tabular-nums; }
  details > h4, details > pre, details > p { margin-left: .8rem; margin-right: .8rem; }
  pre { white-space: pre-wrap; word-break: break-word; font-size: .8rem; line-height: 1.5;
        background: var(--bg); border: 1px solid var(--line); border-radius: 6px;
        padding: .6rem .7rem; margin: .25rem 0 .5rem; max-height: 28rem; overflow: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

  [hidden] { display:none !important; }
  button, input, select { font:inherit; color:inherit; }
  button { border:1px solid var(--line); background:var(--bg); border-radius:6px; cursor:pointer; padding:.35rem .65rem; }
  button:hover { background:var(--panel); }
  :focus-visible { outline:2px solid #5678f5; outline-offset:2px; }
  .trace-heading { display:flex; align-items:center; gap:.8rem; flex-wrap:wrap; }
  .trace-id { color:#526df0; font:12px ui-monospace,monospace; overflow-wrap:anywhere; }
  .trace-stats { display:flex; flex-wrap:wrap; gap:.4rem; margin:.65rem 0; }
  .metric { background:var(--panel); border:1px solid var(--line); border-radius:99px; padding:.15rem .55rem; font-size:12px; }
  .metric b { margin-left:.4rem; }
  .trace-hints { border:1px solid #dde3fd; border-radius:8px; background:var(--panel); padding:.6rem .8rem; color:var(--muted); font-size:12px; }
  .trace-hints button { font-size:12px; padding:.1rem .4rem; margin:.15rem; }
  .trace-tabs { display:flex; gap:.5rem; margin:1rem 0 .4rem; border-bottom:1px solid var(--line); }
  .trace-tabs button { border:0; border-radius:0; padding:.5rem; }
  .trace-tabs [aria-selected=true] { color:#526df0; border-bottom:2px solid #526df0; }
  .trace-toolbar { display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; padding:.5rem 0; font-size:12px; }
  .trace-toolbar input[type=search] { flex:1; min-width:160px; border:1px solid var(--line); background:var(--bg); padding:.45rem .65rem; border-radius:6px; }
  .trace-toolbar select { background:var(--bg); border:1px solid var(--line); border-radius:6px; padding:.35rem; }
  .trace-workspace { display:grid; grid-template-columns:minmax(0,1fr); gap:1rem; }
  .trace-workspace.has-detail { grid-template-columns:minmax(0,1fr) 360px; }
  .trace-tree { min-width:0; }
  .axis-row, .trace-row { display:grid; grid-template-columns:38% 62%; }
  .axis-row { color:var(--muted); font-size:11px; padding:.4rem 0; border-bottom:1px solid var(--line); }
  .axis-ticks { display:flex; justify-content:space-between; margin-left:64px; margin-right:8px; }
  .trace-row { min-height:40px; border-bottom:1px dotted var(--line); }
  .trace-row.selected { background:var(--panel); outline:1px solid #aebafb; }
  .node-label { display:flex; align-items:center; min-width:0; gap:.25rem; }
  .node-toggle { flex:none; border:0; padding:0; width:20px; height:25px; background:transparent; color:var(--muted); }
  .node-select { min-width:0; display:flex; align-items:center; flex-wrap:wrap; gap:.3rem; border:0; text-align:left; padding:.35rem 0; background:transparent; font-size:12px; }
  .node-name { overflow-wrap:anywhere; }
  .node-badge { font-size:10px; padding:.05rem .4rem; border-radius:5px; color:#fff; background:var(--tone); font-weight:600; }
  .node-meta { font-size:10px; color:var(--muted); }
  .node-ENTRY { --tone:#96bb35; } .node-AGENT { --tone:#26b6b2; }
  .node-LLM { --tone:#efa526; } .node-HTTP { --tone:#eec782; }
  .node-TOOL { --tone:#e06ca7; } .node-VERIFY { --tone:#9472d0; }
  .node-PROCESS,.node-OTHER { --tone:#93a2b5; }
  .permission-denied { color:var(--bad); } .permission-reserved { color:#956ab9; }
  .waterfall { display:flex; align-items:center; min-width:0; }
  .node-duration { width:64px; flex:none; text-align:right; padding-right:10px; font-size:10px; color:var(--muted); }
  .bar-track { position:relative; flex:1; height:26px; background:repeating-linear-gradient(to right,transparent 0,transparent calc(25% - 1px),var(--panel) 25%); margin-right:8px; }
  .time-bar { position:absolute; top:10px; height:6px; border-radius:1px; background:var(--tone); min-width:2px; }
  .time-bar.point { width:2px; height:10px; top:8px; }
  .bar-unknown { font-size:10px; color:var(--muted); }
  .trace-detail { min-width:0; border:1px solid var(--line); border-radius:8px; padding:.8rem; max-height:80vh; overflow:auto; position:sticky; top:10px; align-self:start; }
  .detail-head { display:flex; gap:.5rem; justify-content:space-between; align-items:start; }
  .detail-head h3 { margin:0; font-size:14px; overflow-wrap:anywhere; }
  .detail-fields { font-size:12px; overflow-wrap:anywhere; }
  .detail-fields dt { color:var(--muted); margin-top:.4rem; }
  .detail-fields dd { margin:0; }
  .trace-detail pre { max-height:28rem; }
  .trace-detail .capture { margin:.5rem 0; }
  .trace-empty { padding:3rem; text-align:center; color:var(--muted); }
  .trace-footer { font-size:11px; color:var(--muted); margin-top:1rem; }
  @media(max-width:900px) { body {padding:.75rem;} .trace-workspace.has-detail {grid-template-columns:minmax(0,1fr);} .trace-detail {position:static;max-height:none;} .node-duration {width:50px;} .axis-ticks {margin-left:50px;} }
  .diagnostic-row { padding: .5rem; border-left: 3px solid var(--line); margin: .4rem 0; overflow-wrap: anywhere; }
  .trace-health { overflow-wrap: anywhere; }
  .business-summary { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:.5rem; margin:1rem 0; }
  .business-step { border:1px solid var(--line); border-radius:8px; padding:.7rem; background:var(--panel); overflow-wrap:anywhere; font-size:12px; }
  .business-step p { color:var(--muted); margin:.6rem 0 0; }
  .business-occurrences { padding-left:1.5rem; }
  .business-occurrence { padding:.65rem .25rem; border-bottom:1px dotted var(--line); overflow-wrap:anywhere; }
  .business-occurrence a { display:inline-block; padding:.2rem 0; }
  @media(max-width:1100px) { .business-summary {grid-template-columns:repeat(3,minmax(0,1fr));} }
  @media(max-width:650px) { .business-summary {grid-template-columns:repeat(2,minmax(0,1fr));} }
  @media(max-width:400px) { .business-summary {grid-template-columns:minmax(0,1fr);} }
</style>
</head>
<body>
<main>
<div id="trace-app" hidden></div>
<div id="trace-fallback">
<!--TRACE-CONTENT-->
</div>
</main>
<script id="trace-view-data" type="application/json"><!--TRACE-DATA--></script>
<script type="module"><!--TRACE-SCRIPT--></script>
</body>
</html>
